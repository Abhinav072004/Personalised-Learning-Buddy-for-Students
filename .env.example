# ---- LLM (all calls go through LiteLLM; nothing is hard-coded) ----
# Model the solution was tuned and tested on. Any LiteLLM provider string works,
# e.g. openai/<model>, azure/<deployment>, gemini/<model>, anthropic/<model>.
LLM_MODEL=gemini/gemini-2.0-flash
LLM_API_KEY=
# Optional: Azure / self-hosted / proxy endpoint
LLM_API_BASE=
# Only if embeddings are used (the default build does not need embeddings)
EMBEDDING_MODEL=

# Per-call timeout (s) and retries. On timeout / rate-limit the buddy degrades
# to deterministic, template-based answers instead of failing.
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ---- Database ----
POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy
POSTGRES_DB=buddy
DATABASE_URL=postgresql+psycopg://buddy:buddy@db:5432/buddy
